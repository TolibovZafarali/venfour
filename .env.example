# Backend-only Supabase connection and credentials for a manual remote run.
# scripts/dev-local.mjs replaces these with isolated local CLI values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Google OAuth credentials used only by the isolated local Supabase Auth stack.
# Authorize http://127.0.0.1:54321/auth/v1/callback in the Google Web client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace_with_google_web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret

# Live document extraction and market evidence providers.
OPENAI_API_KEY=replace_with_openai_api_key
MARKETCHECK_API_KEY=replace_with_marketcheck_api_key

# Optional server-only, independently verified account radius capability.
# Defaults to 100 miles. Each case-search query is capped at 100 miles;
# a smaller account limit further restricts both inventory endpoints.
# Changing this setting does not change the provider subscription.
# MARKETCHECK_ACCOUNT_MAX_RADIUS_MILES=100

# Case research requires a stable non-secret subscription identifier and
# confirmed account request/rate limits. See docs/engineering/market-search.md.
# Values below intentionally remain unset until account terms are confirmed.
# MARKETCHECK_ACCOUNT_IDENTIFIER=
# MARKETCHECK_RATE_LIMIT_REQUESTS=
# MARKETCHECK_RATE_LIMIT_WINDOW_SECONDS=
# MARKETCHECK_MONTHLY_REQUEST_ALLOWANCE=
# MARKETCHECK_QUOTA_PERIOD_START=
# MARKETCHECK_QUOTA_PERIOD_END=
# MARKETCHECK_MONTHLY_USAGE_BEFORE_TRACKING=
# MARKETCHECK_ACCOUNT_METERED=false
# Optional only for tariffs billing every attempt, by endpoint category.
# MARKETCHECK_CONFIRMED_TARIFF_USD_PER_ATTEMPT=
# Optional only after confirmed permission; 1-30 days, disabled when unset.
# MARKETCHECK_CASE_EVIDENCE_RETENTION_DAYS=
# Engineering defaults; application budgets are not provider entitlements.
# MARKETCHECK_BUDGET_TOTAL_ATTEMPTS=60
# MARKETCHECK_BUDGET_SUPPORTING_ATTEMPTS=5
# MARKETCHECK_BUDGET_SUPPORTING_DISCOVERY_ATTEMPTS=2
# MARKETCHECK_BUDGET_ACTIVE_DISCOVERY_ATTEMPTS=8
# MARKETCHECK_BUDGET_HISTORICAL_DISCOVERY_ATTEMPTS=8
# MARKETCHECK_BUDGET_HISTORY_ATTEMPTS=40
# MARKETCHECK_BUDGET_ENRICHMENT_ATTEMPTS=9
# MARKETCHECK_BUDGET_VEHICLE_TERMS_ATTEMPTS=2
# MARKETCHECK_BUDGET_PER_VIN_HISTORY_ATTEMPTS=3
# MARKETCHECK_MONTHLY_RESERVE_FRACTION=0.20
# MARKETCHECK_OPTIMIZATION_TARGET_MIN=20
# MARKETCHECK_OPTIMIZATION_TARGET_MAX=30
# MARKETCHECK_SEARCH_LOCAL_RADIUS_MILES=100
# MARKETCHECK_SEARCH_OUTER_BOUNDARY_MILES=250
# MARKETCHECK_SEARCH_ADDITIONAL_CENTERS=4
# MARKETCHECK_SEARCH_PAGE_SIZE=50
# MARKETCHECK_SEARCH_PAGES_PER_CENTER=2
# MARKETCHECK_SEARCH_VERIFICATION_BATCH_SIZE=3
# MARKETCHECK_SEARCH_MAX_OBSERVATIONS=500
# MARKETCHECK_SUPPORTING_MAXIMUM_LISTINGS=3
# MARKETCHECK_SEARCH_CURRENT_CONTEXT_PAGES=1

# Optional server-only professional-report review configuration. Report
# generation remains available without these values, but automatic publication
# fails closed unless every identity is approved and the provider-backed eval
# suite for the exact combination has passed.
# OPENAI_REPORT_REVIEW_MODEL=
# OPENAI_REPORT_REVIEW_APPROVED_MODEL=
# OPENAI_REPORT_REVIEW_APPROVED_PROMPT_VERSION=1
# OPENAI_REPORT_REVIEW_APPROVED_SCHEMA_VERSION=1
# OPENAI_REPORT_REVIEW_APPROVED_EVAL_SUITE_DIGEST=
# OPENAI_REPORT_RELEASE_GATE_ENABLED=false

# Optional server-only Stripe commerce configuration. Commerce remains
# unavailable until every value is set to an approved test/live environment.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# VENFOUR_TOTAL_LOSS_STRIPE_PRICE_ID=
# VENFOUR_TOTAL_LOSS_PRODUCT_IDENTIFIER=
# VENFOUR_TOTAL_LOSS_PRODUCT_VERSION=
# VENFOUR_TOTAL_LOSS_TERMS_VERSION=
# VENFOUR_TOTAL_LOSS_REFUND_POLICY_VERSION=
# VENFOUR_PUBLIC_APP_ORIGIN=

# Guest preview completion emails and case recovery reuse Supabase Auth mail.
# Set the public app origin above and these server-only values. The dispatcher
# secret must also be stored in Vault with the API origin; see
# docs/operations/preview-result-recovery.md. Never expose them through VITE_*.
# VENFOUR_TURNSTILE_SECRET=
# VENFOUR_CLAIM_RECOVERY_RATE_LIMIT_SECRET=
# VENFOUR_PREVIEW_EMAIL_DISPATCH_SECRET=

# Referral invitations and completed agreements use a separate server sender.
# Disabled until configured. Local development routes these emails to Mailpit.
# See docs/operations/referral-partners.md for private dispatcher configuration.
# VENFOUR_PARTNER_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# VENFOUR_PARTNER_EMAIL_FROM=
# VENFOUR_PARTNER_EMAIL_REPLY_TO=
# VENFOUR_PARTNER_EMAIL_DISPATCH_SECRET=
# VENFOUR_PARTNER_MAILPIT_ORIGIN=http://127.0.0.1:54324

# Optional server-only package-dispatch configuration. The package processor
# remains dormant unless every value is present. These values prepare a private
# Cloud Tasks -> Cloud Run OIDC boundary; they do not provision a queue.
# VENFOUR_PACKAGE_TASKS_PROJECT=
# VENFOUR_PACKAGE_TASKS_LOCATION=
# VENFOUR_PACKAGE_TASKS_QUEUE=
# VENFOUR_PACKAGE_WORKER_ORIGIN=
# VENFOUR_PACKAGE_TASKS_OIDC_SERVICE_ACCOUNT=
# VENFOUR_PACKAGE_TASKS_OIDC_AUDIENCE=

# Server-only insurer-response interpretation and durable dispatch. The model
# uses OPENAI_API_KEY above and the private worker uses the Cloud Tasks values
# above. OPENAI_INSURER_RESPONSE_ANALYSIS_MODEL is required for the full Total
# Loss customer flow, including --full-flow local development. It is optional
# only for preliminary/fixture development that does not exercise that flow.
# /health is process liveness; /ready requires response analysis in the default
# customer runtime and local full-flow mode. Missing model configuration returns
# 503 with INSURER_RESPONSE_ANALYSIS_MODEL_REQUIRED. Invalid model identifiers
# fail configuration validation; readiness never runs a provider inference.
# Hosted execution also requires the Cloud Tasks/OIDC settings above and the
# dispatch secret below. Local full-flow execution runs in process and needs
# neither remote dispatch nor this secret.
# The dispatch secret must match the Supabase Vault secret named
# venfour_insurer_response_dispatch_secret. The cron wake is inert until that
# secret and venfour_insurer_response_api_origin are both stored in Vault.
# OPENAI_INSURER_RESPONSE_ANALYSIS_MODEL=
# VENFOUR_INSURER_RESPONSE_DISPATCH_SECRET=

# Local compatibility only. Do not use for the production customer path.
# VENFOUR_ENABLE_LEGACY_ANALYSIS_API=1
