{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venfour.com/schemas/package/report-quality-review-v1.schema.json",
  "title": "Venfour report quality review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewedTarget",
    "reviewedDigests",
    "recommendation",
    "confidence",
    "mandatoryChecks",
    "findings",
    "unsupportedConclusions",
    "conflicts",
    "missingEvidence",
    "sourceReferenceValidation",
    "untrustedInstructionDetected",
    "untrustedInstructionFollowed"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "reviewedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceSnapshotId",
        "finalAssessmentId",
        "reportVersionId"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/uuid" },
        "sourceSnapshotId": { "$ref": "#/$defs/uuid" },
        "finalAssessmentId": { "$ref": "#/$defs/uuid" },
        "reportVersionId": { "$ref": "#/$defs/uuid" }
      }
    },
    "reviewedDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputDigest",
        "sourceSnapshotDigest",
        "finalAssessmentDigest",
        "reportDigest",
        "pdfDigest",
        "deterministicValidationDigest",
        "pdfValidationDigest"
      ],
      "properties": {
        "inputDigest": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotDigest": { "$ref": "#/$defs/sha256" },
        "finalAssessmentDigest": { "$ref": "#/$defs/sha256" },
        "reportDigest": { "$ref": "#/$defs/sha256" },
        "pdfDigest": { "$ref": "#/$defs/sha256" },
        "deterministicValidationDigest": { "$ref": "#/$defs/sha256" },
        "pdfValidationDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["PASS", "HUMAN_REVIEW"]
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "mandatoryChecks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/mandatoryCheck" }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/finding" }
    },
    "unsupportedConclusions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/unsupportedConclusion" }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/conflict" }
    },
    "missingEvidence": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/missingEvidence" }
    },
    "sourceReferenceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "citedIds", "unknownIds", "summary"],
      "properties": {
        "status": { "$ref": "#/$defs/checkStatus" },
        "citedIds": {
          "description": "Sorted unique exact union of every sourceEvidenceIds array; empty for a fully PASS package.",
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "unknownIds": {
          "description": "Cited IDs absent from availableEvidenceIds; empty for a fully PASS package.",
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "untrustedInstructionDetected": { "type": "boolean" },
    "untrustedInstructionFollowed": { "type": "boolean" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^(ev|ref)_[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "nullableText": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000
    },
    "checkId": {
      "type": "string",
      "enum": [
        "LINEAGE",
        "SUBJECT_VEHICLE",
        "INSURER_VALUATION",
        "INSURER_COMPARABLES",
        "EXTERNAL_COMPARABLES",
        "CALCULATIONS",
        "METHODOLOGY_BOUNDARIES",
        "EVIDENCE_ATTRIBUTION",
        "LIMITATIONS",
        "PDF_CONSISTENCY",
        "OVERALL_CONCLUSION"
      ]
    },
    "checkStatus": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNCERTAIN"]
    },
    "evidenceIds": {
      "description": "Exact IDs copied from availableEvidenceIds; all evidence-ID arrays are empty for a fully PASS package.",
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceId" }
    },
    "mandatoryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "summary", "sourceEvidenceIds"],
      "properties": {
        "checkId": { "$ref": "#/$defs/checkId" },
        "status": { "$ref": "#/$defs/checkStatus" },
        "summary": { "$ref": "#/$defs/summary" },
        "sourceEvidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "findingCategory": {
      "type": "string",
      "enum": [
        "LINEAGE",
        "SUBJECT_VEHICLE",
        "INSURER_VALUATION",
        "INSURER_COMPARABLES",
        "EXTERNAL_COMPARABLES",
        "CALCULATIONS",
        "METHODOLOGY_BOUNDARIES",
        "EVIDENCE_ATTRIBUTION",
        "LIMITATIONS",
        "PDF_CONSISTENCY",
        "OVERALL_CONCLUSION",
        "SOURCE_REFERENCE",
        "PROMPT_INJECTION",
        "OTHER"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "category",
        "description",
        "reportSection",
        "sourceEvidenceIds",
        "expected",
        "observed",
        "recommendedHumanAction"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "category": { "$ref": "#/$defs/findingCategory" },
        "description": { "$ref": "#/$defs/description" },
        "reportSection": { "$ref": "#/$defs/nullableText" },
        "sourceEvidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "expected": { "$ref": "#/$defs/nullableText" },
        "observed": { "$ref": "#/$defs/nullableText" },
        "recommendedHumanAction": { "$ref": "#/$defs/description" }
      }
    },
    "unsupportedConclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "reportSection", "sourceEvidenceIds"],
      "properties": {
        "description": { "$ref": "#/$defs/description" },
        "reportSection": { "$ref": "#/$defs/nullableText" },
        "sourceEvidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "expected", "observed", "sourceEvidenceIds"],
      "properties": {
        "description": { "$ref": "#/$defs/description" },
        "expected": { "$ref": "#/$defs/nullableText" },
        "observed": { "$ref": "#/$defs/nullableText" },
        "sourceEvidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "missingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "requiredFor", "sourceEvidenceIds"],
      "properties": {
        "description": { "$ref": "#/$defs/description" },
        "requiredFor": { "$ref": "#/$defs/description" },
        "sourceEvidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    }
  }
}
