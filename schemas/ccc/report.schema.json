{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour CCC Valuation Report",
  "type": "object",

  "properties": {
    "report": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "reportReferenceNumber": { "type": ["string", "null"] },
        "claimReferenceNumber": { "type": ["string", "null"] },
        "lossDate": { "type": ["string", "null"] },
        "reportDate": { "type": ["string", "null"] }
      }
    },

    "vehicle": {
      "type": "object",
      "properties": {
        "year": { "type": ["integer", "null"] },
        "make": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "trim": { "type": ["string", "null"] },
        "vin": { "type": ["string", "null"] },
        "mileage": { "type": ["integer", "null"] },
        "location": { "type": ["string", "null"] },
        "bodyStyle": { "type": ["string", "null"] },
        "engine": { "type": ["string", "null"] },
        "transmission": { "type": ["string", "null"] },
        "fuelType": { "type": ["string", "null"] },
        "equipment": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "valuation": {
      "type": "object",
      "properties": {
        "baseVehicleValue": { "type": ["number", "null"] },
        "conditionAdjustment": { "type": ["number", "null"] },
        "adjustedVehicleValue": { "type": ["number", "null"] },
        "total": { "type": ["number", "null"] }
      }
    },

    "condition": {
      "type": "object",
      "properties": {
        "totalAdjustment": { "type": ["number", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": ["string", "null"] },
              "component": { "type": ["string", "null"] },
              "rating": { "type": ["string", "null"] },
              "notes": { "type": ["string", "null"] },
              "valueImpact": { "type": ["number", "null"] }
            }
          }
        }
      }
    },

    "comparables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": ["integer", "null"] },
          "year": { "type": ["integer", "null"] },
          "make": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "trim": { "type": ["string", "null"] },
          "vin": { "type": ["string", "null"] },

          "dealer": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] },
          "distanceMiles": { "type": ["number", "null"] },

          "mileage": { "type": ["integer", "null"] },
          "listPrice": { "type": ["number", "null"] },

          "adjustments": {
            "type": "object",
            "properties": {
              "package": { "type": ["number", "null"] },
              "options": { "type": ["number", "null"] },
              "mileage": { "type": ["number", "null"] },
              "condition": { "type": ["number", "null"] }
            }
          },

          "adjustedValue": { "type": ["number", "null"] },
          "contributionPercent": { "type": ["number", "null"] }
        }
      }
    },

    "valuationNotes": {
      "type": "array",
      "items": { "type": "string" }
    },

    "supplementalInformation": {
      "type": "object",
      "properties": {
        "historyChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "historyEvents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recalls": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}