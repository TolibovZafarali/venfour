{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour Market Search Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "request", "listings", "listingCount"],
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "request": {
      "$ref": "#/$defs/searchRequest"
    },
    "listings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/listing"
      }
    },
    "listingCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "searchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "make", "model"],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "make": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "trim": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "configuration": {
          "oneOf": [
            { "$ref": "#/$defs/vehicleConfiguration" },
            { "type": "null" }
          ]
        },
        "lossVehicleMileage": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "postalCode": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "radiusMiles": {
          "type": "integer",
          "minimum": 0,
          "default": 50
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        }
      }
    },
    "vehicleConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "field", "values"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,49}$"
        },
        "field": { "enum": ["trim", "version"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^,\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "year", "make", "model", "price"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sourceListingId": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "listingUrl": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "make": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "trim": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "vin": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "mileage": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "dealer": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": ["string", "null"],
              "minLength": 1,
              "pattern": "\\S"
            },
            "city": {
              "type": ["string", "null"],
              "minLength": 1,
              "pattern": "\\S"
            },
            "state": {
              "type": ["string", "null"],
              "minLength": 1,
              "pattern": "\\S"
            },
            "postalCode": {
              "type": ["string", "null"],
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "distanceMiles": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    }
  }
}
