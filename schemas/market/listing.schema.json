{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour Market Listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "year", "make", "model", "price"],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sourceListingId": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "listingUrl": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "year": {
      "type": "integer",
      "minimum": 0
    },
    "make": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "trim": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "vin": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "mileage": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "dealer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "city": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "state": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "postalCode": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "distanceMiles": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "drivetrain": {
      "enum": [
        "FWD",
        "RWD",
        "AWD",
        "4WD",
        null
      ]
    }
  }
}
