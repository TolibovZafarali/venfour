{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour Historical Market Search Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceDate", "year", "make", "model", "postalCode"],
  "properties": {
    "evidenceDate": {
      "type": "string",
      "format": "date"
    },
    "year": {
      "type": "integer",
      "minimum": 0
    },
    "make": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "trim": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "configuration": {
      "oneOf": [
        { "$ref": "#/$defs/vehicleConfiguration" },
        { "type": "null" }
      ]
    },
    "lossVehicleMileage": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "postalCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "radiusMiles": {
      "type": "integer",
      "minimum": 0,
      "default": 50
    },
    "resultLimit": {
      "type": "integer",
      "minimum": 1,
      "default": 25
    }
  },
  "$defs": {
    "vehicleConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "field", "values"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,49}$"
        },
        "field": { "enum": ["trim", "version"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^,\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    }
  }
}
