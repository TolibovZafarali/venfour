{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.venfour.local/analysis/analysis-run.schema.json",
  "title": "Venfour Analysis Run",
  "oneOf": [
    {
      "$ref": "#/$defs/analysisRunV1"
    },
    {
      "$ref": "#/$defs/analysisRunV2"
    },
    {
      "$ref": "#/$defs/analysisRunV3"
    },
    {
      "$ref": "#/$defs/analysisRunV4"
    }
  ],
  "$defs": {
    "analysisRunV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisRunSchemaVersion",
        "runId",
        "createdAt",
        "analysisVersion",
        "discrepancyAnalysisVersion",
        "comparableScoringVersion",
        "requestDigest",
        "providers",
        "request",
        "result"
      ],
      "properties": {
        "analysisRunSchemaVersion": {
          "const": "1"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "analysisVersion": {
          "const": "1"
        },
        "discrepancyAnalysisVersion": {
          "const": "1"
        },
        "comparableScoringVersion": {
          "const": "1"
        },
        "requestDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "providers": {
          "$ref": "#/$defs/providers"
        },
        "request": {
          "$ref": "#/$defs/analysisRunRequestV1"
        },
        "result": {
          "$ref": "#/$defs/analysisRunResultV1"
        }
      }
    },
    "analysisRunV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisRunSchemaVersion",
        "runId",
        "createdAt",
        "analysisVersion",
        "discrepancyAnalysisVersion",
        "comparableScoringVersion",
        "requestDigest",
        "searchDiagnosticsDigest",
        "providers",
        "request",
        "result"
      ],
      "properties": {
        "analysisRunSchemaVersion": {
          "const": "2"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "analysisVersion": {
          "const": "2"
        },
        "discrepancyAnalysisVersion": {
          "const": "1"
        },
        "comparableScoringVersion": {
          "const": "1"
        },
        "requestDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "searchDiagnosticsDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "providers": {
          "$ref": "#/$defs/providers"
        },
        "request": {
          "$ref": "#/$defs/analysisRunRequestV2"
        },
        "result": {
          "$ref": "#/$defs/analysisRunResultV2"
        }
      }
    },
    "analysisRunV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisRunSchemaVersion",
        "runId",
        "createdAt",
        "analysisVersion",
        "discrepancyAnalysisVersion",
        "comparableScoringVersion",
        "requestDigest",
        "searchDiagnosticsDigest",
        "providers",
        "request",
        "result"
      ],
      "properties": {
        "analysisRunSchemaVersion": {
          "const": "3"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "analysisVersion": {
          "const": "3"
        },
        "discrepancyAnalysisVersion": {
          "const": "1"
        },
        "comparableScoringVersion": {
          "const": "1"
        },
        "requestDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "searchDiagnosticsDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "providers": {
          "$ref": "#/$defs/providers"
        },
        "request": {
          "$ref": "#/$defs/analysisRunRequestV3"
        },
        "result": {
          "$ref": "#/$defs/analysisRunResultV3"
        }
      }
    },
    "analysisRunV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisRunSchemaVersion",
        "runId",
        "createdAt",
        "analysisVersion",
        "discrepancyAnalysisVersion",
        "comparableScoringVersion",
        "requestDigest",
        "searchDiagnosticsDigest",
        "providers",
        "request",
        "result"
      ],
      "properties": {
        "analysisRunSchemaVersion": {
          "const": "4"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "analysisVersion": {
          "const": "4"
        },
        "discrepancyAnalysisVersion": {
          "const": "1"
        },
        "comparableScoringVersion": {
          "const": "1"
        },
        "requestDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "searchDiagnosticsDigest": {
          "$ref": "#/$defs/requestDigest"
        },
        "providers": {
          "$ref": "#/$defs/providers"
        },
        "request": {
          "$ref": "#/$defs/analysisRunRequestV4"
        },
        "result": {
          "$ref": "#/$defs/analysisRunResultV4"
        }
      }
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "nullableProviderMetadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/providerMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "historical"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/nullableProviderMetadata"
        },
        "historical": {
          "$ref": "#/$defs/nullableProviderMetadata"
        }
      }
    },
    "analysisRunRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseDiscrepancyRequest",
        "lossDateSource",
        "lossDateOverride",
        "currentSearchRequest",
        "historicalSearchRequest",
        "currentObservedDate"
      ],
      "properties": {
        "baseDiscrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "lossDateSource": {
          "enum": [
            "CCC_REPORT",
            "OVERRIDE"
          ]
        },
        "lossDateOverride": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "currentSearchRequest": {
          "$ref": "#/$defs/nullableCurrentSearchRequest"
        },
        "historicalSearchRequest": {
          "$ref": "#/$defs/nullableHistoricalSearchRequest"
        },
        "currentObservedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "analysisRunRequestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseDiscrepancyRequest",
        "lossDateSource",
        "lossDateOverride",
        "currentSearchRequest",
        "historicalSearchRequest",
        "currentObservedDate",
        "searchPolicy"
      ],
      "properties": {
        "baseDiscrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "lossDateSource": {
          "enum": [
            "CCC_REPORT",
            "OVERRIDE"
          ]
        },
        "lossDateOverride": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "currentSearchRequest": {
          "$ref": "#/$defs/nullableCurrentSearchRequest"
        },
        "historicalSearchRequest": {
          "$ref": "#/$defs/nullableHistoricalSearchRequest"
        },
        "currentObservedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "searchPolicy": {
          "$ref": "#/$defs/searchPolicy"
        }
      }
    },
    "analysisRunRequestV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseDiscrepancyRequest",
        "lossDateSource",
        "lossDateOverride",
        "currentSearchRequest",
        "historicalSearchRequest",
        "currentObservedDate",
        "searchPolicies"
      ],
      "properties": {
        "baseDiscrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "lossDateSource": {
          "enum": [
            "CCC_REPORT",
            "OVERRIDE"
          ]
        },
        "lossDateOverride": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "currentSearchRequest": {
          "$ref": "#/$defs/nullableCurrentSearchRequest"
        },
        "historicalSearchRequest": {
          "$ref": "#/$defs/nullableHistoricalSearchRequest"
        },
        "currentObservedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "searchPolicies": {
          "$ref": "#/$defs/searchPolicies"
        }
      }
    },
    "analysisRunRequestV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseDiscrepancyRequest",
        "lossDateSource",
        "lossDateOverride",
        "currentSearchRequest",
        "historicalSearchRequest",
        "currentObservedDate",
        "configuredSearchPolicies",
        "searchPolicies"
      ],
      "properties": {
        "baseDiscrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "lossDateSource": {
          "enum": [
            "CCC_REPORT",
            "OVERRIDE"
          ]
        },
        "lossDateOverride": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "currentSearchRequest": {
          "$ref": "#/$defs/nullableCurrentSearchRequest"
        },
        "historicalSearchRequest": {
          "$ref": "#/$defs/nullableHistoricalSearchRequest"
        },
        "currentObservedDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "configuredSearchPolicies": {
          "$ref": "#/$defs/searchPolicies"
        },
        "searchPolicies": {
          "$ref": "#/$defs/searchPolicies"
        }
      }
    },
    "nullableCurrentSearchRequest": {
      "oneOf": [
        {
          "$ref": "https://schemas.venfour.local/market/search-request.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHistoricalSearchRequest": {
      "oneOf": [
        {
          "$ref": "https://schemas.venfour.local/market/historical-search-request.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "searchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "minimumStrongMatches",
        "maxUniqueCandidates",
        "identityStrategy",
        "priceIndependent"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/searchPolicyStage"
          }
        },
        "minimumStrongMatches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxUniqueCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "identityStrategy": {
          "const": "VIN_THEN_SOURCE_LISTING_ID"
        },
        "priceIndependent": {
          "const": true
        }
      }
    },
    "searchPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "historical"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/searchPolicy"
        },
        "historical": {
          "$ref": "#/$defs/searchPolicy"
        }
      }
    },
    "searchPolicyStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radiusMiles",
        "resultLimit"
      ],
      "properties": {
        "radiusMiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "analysisRunResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentMarketResult",
        "historicalMarketResult",
        "currentRanking",
        "historicalRanking",
        "discrepancyRequest",
        "discrepancyResult"
      ],
      "properties": {
        "currentMarketResult": {
          "$ref": "#/$defs/nullableCurrentMarketResult"
        },
        "historicalMarketResult": {
          "$ref": "#/$defs/nullableHistoricalMarketResult"
        },
        "currentRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "historicalRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "discrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "discrepancyResult": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-result.schema.json"
        }
      }
    },
    "analysisRunResultV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentMarketResult",
        "historicalMarketResult",
        "currentRanking",
        "historicalRanking",
        "discrepancyRequest",
        "discrepancyResult",
        "searchDiagnostics"
      ],
      "properties": {
        "currentMarketResult": {
          "$ref": "#/$defs/nullableCurrentMarketResult"
        },
        "historicalMarketResult": {
          "$ref": "#/$defs/nullableHistoricalMarketResult"
        },
        "currentRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "historicalRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "discrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "discrepancyResult": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-result.schema.json"
        },
        "searchDiagnostics": {
          "$ref": "#/$defs/searchDiagnostics"
        }
      }
    },
    "analysisRunResultV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentMarketResult",
        "historicalMarketResult",
        "currentRanking",
        "historicalRanking",
        "discrepancyRequest",
        "discrepancyResult",
        "searchDiagnostics"
      ],
      "properties": {
        "currentMarketResult": {
          "$ref": "#/$defs/nullableCurrentMarketResult"
        },
        "historicalMarketResult": {
          "$ref": "#/$defs/nullableHistoricalMarketResult"
        },
        "currentRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "historicalRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "discrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "discrepancyResult": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-result.schema.json"
        },
        "searchDiagnostics": {
          "$ref": "#/$defs/searchDiagnosticsV3"
        }
      }
    },
    "analysisRunResultV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentMarketResult",
        "historicalMarketResult",
        "currentRanking",
        "historicalRanking",
        "discrepancyRequest",
        "discrepancyResult",
        "searchDiagnostics"
      ],
      "properties": {
        "currentMarketResult": {
          "$ref": "#/$defs/nullableCurrentMarketResult"
        },
        "historicalMarketResult": {
          "$ref": "#/$defs/nullableHistoricalMarketResult"
        },
        "currentRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "historicalRanking": {
          "$ref": "#/$defs/nullableRankingResult"
        },
        "discrepancyRequest": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-request.schema.json"
        },
        "discrepancyResult": {
          "$ref": "https://schemas.venfour.local/analysis/valuation-discrepancy-result.schema.json"
        },
        "searchDiagnostics": {
          "$ref": "#/$defs/searchDiagnosticsV4"
        }
      }
    },
    "nullableCurrentMarketResult": {
      "oneOf": [
        {
          "$ref": "https://schemas.venfour.local/market/search-result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHistoricalMarketResult": {
      "oneOf": [
        {
          "$ref": "https://schemas.venfour.local/market/historical-search-result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableRankingResult": {
      "oneOf": [
        {
          "$ref": "https://schemas.venfour.local/comparables/ranking-result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "searchDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "historical"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/nullableCurrentSearchDiagnostics"
        },
        "historical": {
          "$ref": "#/$defs/nullableHistoricalSearchDiagnostics"
        }
      }
    },
    "searchDiagnosticsV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "historical"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/nullableCurrentSearchDiagnostics"
        },
        "historical": {
          "$ref": "#/$defs/nullableHistoricalSearchDiagnosticsV3"
        }
      }
    },
    "searchDiagnosticsV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "historical"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/nullableCurrentSearchDiagnosticsV4"
        },
        "historical": {
          "$ref": "#/$defs/nullableHistoricalSearchDiagnosticsV3"
        }
      }
    },
    "nullableCurrentSearchDiagnostics": {
      "oneOf": [
        {
          "$ref": "#/$defs/currentSearchDiagnostics"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableCurrentSearchDiagnosticsV4": {
      "oneOf": [
        {
          "$ref": "#/$defs/currentSearchDiagnosticsV4"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHistoricalSearchDiagnostics": {
      "oneOf": [
        {
          "$ref": "#/$defs/historicalSearchDiagnostics"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHistoricalSearchDiagnosticsV3": {
      "oneOf": [
        {
          "$ref": "#/$defs/historicalSearchDiagnosticsV3"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentSearchDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "stopReason"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/currentSearchAttempt"
          }
        },
        "stopReason": {
          "$ref": "#/$defs/searchStopReason"
        }
      }
    },
    "currentSearchDiagnosticsV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "stopReason"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/currentSearchAttempt"
          }
        },
        "stopReason": {
          "$ref": "#/$defs/currentSearchStopReasonV4"
        }
      }
    },
    "historicalSearchDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "stopReason"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/historicalSearchAttempt"
          }
        },
        "stopReason": {
          "$ref": "#/$defs/searchStopReason"
        }
      }
    },
    "historicalSearchDiagnosticsV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "stopReason"
      ],
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/historicalSearchAttempt"
          }
        },
        "stopReason": {
          "$ref": "#/$defs/historicalSearchStopReasonV3"
        }
      }
    },
    "currentSearchAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "returnedCount",
        "resolvedCount",
        "unresolvedCount",
        "ambiguousCount",
        "newUniqueCount",
        "duplicateCount",
        "candidateLimitExcludedCount",
        "cumulativeUniqueCount",
        "eligibleCount",
        "strongMatchCount"
      ],
      "properties": {
        "result": {
          "$ref": "https://schemas.venfour.local/market/search-result.schema.json"
        },
        "returnedCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "resolvedCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "unresolvedCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "ambiguousCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "newUniqueCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "duplicateCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "candidateLimitExcludedCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "cumulativeUniqueCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "eligibleCount": {
          "$ref": "#/$defs/nonNegativeCount"
        },
        "strongMatchCount": {
          "$ref": "#/$defs/nonNegativeCount"
        }
      }
    },
    "historicalSearchAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "returnedCount",
        "resolvedCount",
        "unresolvedCount",
        "ambiguousCount",
