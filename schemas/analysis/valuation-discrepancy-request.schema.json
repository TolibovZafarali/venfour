        "radiusMiles": {
          "type": "integer",
          "minimum": 0,
          "default": 50
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "drivetrain": {
          "enum": [
            "FWD",
            "RWD",
            "AWD",
            "4WD",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "configuration"
            ],
            "properties": {
              "configuration": {
                "type": "object"
              }
            }
          },
          "then": {
            "required": [
              "trim"
            ],
            "properties": {
              "trim": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "vehicleConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "field",
        "values"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,49}$"
        },
        "field": {
          "enum": [
            "trim",
            "version"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^,\\u0000-\\u001F\\u007F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        }
      }
    },
    "historicalEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing",
        "temporalEvidence"
      ],
      "properties": {
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "temporalEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis",
            "evidenceDate",
            "recordFirstSeenAt",
            "recordLastSeenAt",
            "sourceFirstSeenAt",
            "sourceLastSeenAt"
          ],
          "properties": {
            "status": {
              "const": "RESOLVED"
            },
            "basis": {
              "const": "LISTING_RECORD_ACTIVE_ON_DATE"
            },
            "evidenceDate": {
              "type": "string",
              "format": "date"
            },
            "recordFirstSeenAt": {
              "type": "string",
              "format": "date-time"
            },
            "recordLastSeenAt": {
              "type": "string",
              "format": "date-time"
            },
            "sourceFirstSeenAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "sourceLastSeenAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "vin",
        "sourceListingId"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNRESOLVED",
            "AMBIGUOUS"
          ]
        },
        "reason": {
          "enum": [
            "RECORD_INTERVAL_BEFORE_EVIDENCE_DATE",
            "RECORD_INTERVAL_AFTER_EVIDENCE_DATE",
            "MISSING_RECORD_TIMESTAMPS",
            "MALFORMED_RECORD_TIMESTAMPS",
            "INCONSISTENT_RECORD_TIMESTAMPS",
            "INVALID_RECORD_INTERVAL",
            "MALFORMED_SOURCE_TIMESTAMPS",
            "INCONSISTENT_SOURCE_TIMESTAMPS",
            "INVALID_SOURCE_INTERVAL",
            "RECORD_OUTSIDE_SOURCE_INTERVAL",
            "NO_RECORD_ACTIVE_ON_EVIDENCE_DATE",
            "MISSING_LISTING_IDENTITY",
            "UNVERIFIABLE_RECORD_CONTEXT",
            "MULTIPLE_SOURCE_RECORDS_ON_EVIDENCE_DATE",
            "PAGINATION_SAFETY_LIMIT_REACHED",
            "INCOMPLETE_PROVIDER_PAGINATION",
            "CANDIDATE_VERIFICATION_LIMIT_REACHED"
          ]
        },
        "vin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceListingId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "historicalSearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "evidenceDate",
        "asOfDate",
        "coverage",
        "request",
        "evidence",
        "listingCount",
        "issues",
        "unresolvedCount",
        "ambiguousCount"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "evidenceDate": {
          "type": "string",
          "format": "date"
        },
        "asOfDate": {
          "type": "string",
          "format": "date"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "historyWindowDays"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUPPORTED",
                "OUT_OF_PROVIDER_RANGE"
              ]
            },
            "historyWindowDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "request": {
          "$ref": "#/$defs/historicalSearchRequest"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historicalEvidenceItem"
          }
        },
        "listingCount": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguousCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
