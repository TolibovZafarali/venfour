{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.venfour.local/analysis/insurer-response-recommendation-v1.schema.json",
  "title": "Venfour insurer response recommendation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "state", "summary", "reasons", "reasonCodes", "limitations", "responseEvidenceRefs", "caseEvidenceRefs", "offer", "policyInput"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "policyVersion": { "const": "1" },
    "state": { "enum": ["ACCEPT_OFFER", "CONTINUE_CHALLENGING", "NO_CLEAR_RECOMMENDATION"] },
    "summary": { "$ref": "#/$defs/text" },
    "reasons": { "$ref": "#/$defs/texts" },
    "limitations": { "$ref": "#/$defs/texts" },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } },
    "responseEvidenceRefs": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "type": "string", "pattern": "^response_[0-9a-f]{64}$" } },
    "caseEvidenceRefs": { "type": "array", "maxItems": 250, "uniqueItems": true, "items": { "type": "string", "pattern": "^case_[0-9a-f]{64}$" } },
    "offer": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["amountMinorUnits", "currency", "source"], "properties": {
          "amountMinorUnits": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "source": { "enum": ["CUSTOMER_RECORDED", "RESPONSE_TEXT"] }
        } }
      ]
    },
    "policyInput": {
      "type": "object", "additionalProperties": false,
      "required": ["assessmentDigest", "finalClassification", "evidenceStrength", "evidenceBasis", "continuationStatus", "supportedRange", "validationIssues", "preliminaryToFinalComparison"],
      "properties": {
        "assessmentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "finalClassification": { "type": ["string", "null"] },
        "evidenceStrength": { "type": ["string", "null"] },
        "evidenceBasis": { "type": ["string", "null"] },
        "continuationStatus": { "type": ["string", "null"] },
        "supportedRange": { "type": ["object", "null"] },
        "validationIssues": { "type": "array", "items": { "type": "object" } },
        "preliminaryToFinalComparison": { "type": ["object", "null"] }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "texts": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/text" } }
  }
}
