{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour Comparable Ranking Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scoringVersion",
    "target",
    "provider",
    "totalListingCount",
    "eligibleCount",
    "ineligibleCount",
    "tierCounts",
    "candidates"
  ],
  "properties": {
    "scoringVersion": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "totalListingCount": {
      "type": "integer",
      "minimum": 0
    },
    "eligibleCount": {
      "type": "integer",
      "minimum": 0
    },
    "ineligibleCount": {
      "type": "integer",
      "minimum": 0
    },
    "tierCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "STRONG",
        "GOOD",
        "WEAK",
        "INELIGIBLE"
      ],
      "properties": {
        "STRONG": {
          "type": "integer",
          "minimum": 0
        },
        "GOOD": {
          "type": "integer",
          "minimum": 0
        },
        "WEAK": {
          "type": "integer",
          "minimum": 0
        },
        "INELIGIBLE": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "make",
        "model",
        "trim",
        "mileage",
        "postalCode"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "make": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "trim": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "mileage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "postalCode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "drivetrain": {
          "enum": [
            "FWD",
            "RWD",
            "AWD",
            "4WD",
            null
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing",
        "eligible",
        "score",
        "tier",
        "rank",
        "components",
        "reasons"
      ],
      "properties": {
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "eligible": {
          "type": "boolean"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "tier": {
          "type": "string",
          "enum": [
            "STRONG",
            "GOOD",
            "WEAK",
            "INELIGIBLE"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "trim",
            "mileage",
            "distance"
          ],
          "properties": {
            "year": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "score",
                "maxScore",
                "difference"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "maxScore": {
                  "type": "number",
                  "const": 20
                },
                "difference": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "trim": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "score",
                "maxScore",
                "match"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "maxScore": {
                  "type": "number",
                  "const": 20
                },
                "match": {
                  "type": "string",
                  "enum": [
                    "EXACT",
                    "DIFFERENT",
                    "LISTING_UNAVAILABLE",
                    "TARGET_UNAVAILABLE",
                    "UNAVAILABLE"
                  ]
                }
              }
            },
            "mileage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "score",
                "maxScore",
                "differenceMiles"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 50
                },
                "maxScore": {
                  "type": "number",
                  "const": 50
                },
                "differenceMiles": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            },
            "distance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "score",
                "maxScore",
                "distanceMiles"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "maxScore": {
                  "type": "number",
                  "const": 10
                },
                "distanceMiles": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "EXACT_MAKE",
              "MAKE_MISMATCH",
              "EXACT_MODEL",
              "MODEL_MISMATCH",
              "EXACT_YEAR",
              "YEAR_DIFFERENCE_ONE",
              "YEAR_DIFFERENCE_MULTIPLE",
              "EXACT_TRIM",
              "DIFFERENT_TRIM",
              "LISTING_TRIM_UNAVAILABLE",
              "TARGET_TRIM_UNAVAILABLE",
              "TRIM_UNAVAILABLE",
              "MILEAGE_EXACT",
              "MILEAGE_VERY_CLOSE",
              "MILEAGE_CLOSE",
              "MILEAGE_MODERATE",
              "MILEAGE_FAR",
              "LISTING_MILEAGE_UNAVAILABLE",
              "TARGET_MILEAGE_UNAVAILABLE",
              "MILEAGE_UNAVAILABLE",
              "DISTANCE_CLOSE",
              "DISTANCE_MODERATE",
              "DISTANCE_FAR",
              "DISTANCE_UNAVAILABLE",
              "DISTANCE_ORIGIN_UNAVAILABLE",
              "VIN_UNAVAILABLE",
              "EXACT_DRIVETRAIN",
              "DRIVETRAIN_MISMATCH",
              "LISTING_DRIVETRAIN_UNAVAILABLE"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            },
            "required": [
              "eligible"
            ]
          },
          "then": {
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "tier": {
                "type": "string",
                "enum": [
                  "STRONG",
                  "GOOD",
                  "WEAK"
                ]
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              },
              "tier": {
                "const": "INELIGIBLE"
              },
              "rank": {
                "type": "null"
              }
            }
          }
        }
      ],
      "$defs": {
        "listing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "year",
            "make",
            "model",
            "price"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "sourceListingId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "listingUrl": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "year": {
              "type": "integer",
              "minimum": 0
            },
            "make": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "trim": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "vin": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "mileage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "price": {
              "type": "number",
              "minimum": 0
            },
            "dealer": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "city": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "state": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "postalCode": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "distanceMiles": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "drivetrain": {
              "enum": [
                "FWD",
                "RWD",
                "AWD",
                "4WD",
                null
              ]
            }
          }
        }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "year",
        "make",
        "model",
        "price"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sourceListingId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "listingUrl": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "make": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "trim": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "vin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "mileage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "dealer": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "city": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "state": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "postalCode": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "distanceMiles": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "drivetrain": {
          "enum": [
            "FWD",
            "RWD",
            "AWD",
            "4WD",
            null
          ]
        }
      }
    }
  }
}
