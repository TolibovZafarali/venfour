{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venfour Comparable Target",
  "type": "object",
  "additionalProperties": false,
  "required": ["year", "make", "model", "trim", "mileage", "postalCode"],
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 0
    },
    "make": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "trim": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "mileage": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "postalCode": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    },
    "drivetrain": {
      "enum": [
        "FWD",
        "RWD",
        "AWD",
        "4WD",
        null
      ]
    }
  }
}
