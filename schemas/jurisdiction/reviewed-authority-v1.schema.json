            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "approved_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\x00-\\x1f]+$"
                }
              },
              "required": [
                "reviewer",
                "approved_at",
                "evidence"
              ],
              "additionalProperties": false
