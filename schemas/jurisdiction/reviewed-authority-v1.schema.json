{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:venfour:reviewed-authority:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "reviewed-authority-1"
      ]
