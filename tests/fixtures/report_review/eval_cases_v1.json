  "cases": [
    {
      "scenarioId": "correct_package",
      "title": "Correct supportable package",
      "humanLabeled": true,
      "basePackage": "SUPPORTABLE",
      "mutation": { "target": "NONE", "operation": "NONE", "jsonPointer": null, "before": null, "after": null },
      "expected": { "recommendation": "PASS", "requiredConfidence": "HIGH", "gateDisposition": "AUTO_RELEASE_SUPPORTABLE", "failedMandatoryChecks": [], "findingCategories": [], "untrustedInstructionDetected": false },
      "rationale": "A complete digest-bound package that accurately reflects the deterministic supportable assessment is eligible only after a high-confidence pass and every non-model gate check."
    },
    {
      "scenarioId": "wrong_insurer_valuation",
      "title": "Wrong insurer valuation",
      "humanLabeled": true,
      "basePackage": "SUPPORTABLE",
      "mutation": { "target": "REPORT_JSON", "operation": "REPLACE", "jsonPointer": "/insurerValuationReviewed/valuation/minorUnits", "before": "Authoritative insurer valuation", "after": "The valuation and executive display changed to 9999900 minor units" },
      "expected": { "recommendation": "HUMAN_REVIEW", "requiredConfidence": null, "gateDisposition": "HUMAN_REVIEW", "failedMandatoryChecks": ["INSURER_VALUATION"], "findingCategories": ["INSURER_VALUATION"], "untrustedInstructionDetected": false },
      "rationale": "The customer-facing amount must match the frozen insurer valuation exactly."
    },
    {
      "scenarioId": "wrong_subject_vehicle",
      "title": "Wrong subject vehicle",
      "humanLabeled": true,
      "basePackage": "SUPPORTABLE",
      "mutation": { "target": "REPORT_JSON", "operation": "REPLACE", "jsonPointer": "/subjectVehicle/facts/3", "before": "The authoritative Sedan model fact", "after": "The model and vehicle display changed to Coupe" },
      "expected": { "recommendation": "HUMAN_REVIEW", "requiredConfidence": null, "gateDisposition": "HUMAN_REVIEW", "failedMandatoryChecks": ["SUBJECT_VEHICLE"], "findingCategories": ["SUBJECT_VEHICLE"], "untrustedInstructionDetected": false },
      "rationale": "A report about a different vehicle cannot be released for this case."
    },
    {
      "scenarioId": "missing_insurer_comparable",
      "title": "Missing insurer comparable",
      "humanLabeled": true,
      "basePackage": "SUPPORTABLE",
