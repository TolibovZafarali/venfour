# Keep this empty when the frontend and API share an origin.
VITE_API_BASE_URL=

# Optional public email shown on Venfour's Contact page.
VITE_SUPPORT_EMAIL=

# Public Supabase browser configuration. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The one-command local launcher injects Cloudflare's official test site key.
# Never use that test key with the linked project or in a production build.
VITE_TURNSTILE_SITE_KEY=

# Vite proxies /api and /health here during local development.
VENFOUR_API_PROXY_TARGET=http://127.0.0.1:8000
